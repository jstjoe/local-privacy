                    }
                  },
                  "unknown_detector": {
                    "summary": "Unknown detector",
                    "value": {
                      "detail": "unknown detector 'foo'; available: ['gliner', 'opf', 'presidio']"
                    }
                  }
                }
              }
            },
            "description": "Unknown detector or missing config for the chosen mode."
          },
          "422": {
